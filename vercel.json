{
  "framework": "astro",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "evictionnoticegenerator.com" }],
      "destination": "https://www.evictionnoticegenerator.com/$1",
      "permanent": true
    }
  ]
}
