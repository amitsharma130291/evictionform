---
export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonicalUrl?: string;
}

const {
  title = "Free Eviction Notice Generator | EvictionNoticeGenerator",
  description = "Generate a free, state-compliant eviction notice in minutes. Download instantly. Covers all 50 US states.",
  ogTitle = "Free Eviction Notice Generator | EvictionNoticeGenerator",
  ogDescription = "Generate a free, state-compliant eviction notice in minutes. Download instantly. Covers all 50 US states.",
  canonicalUrl,
} = Astro.props;

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, 'https://www.evictionnoticegenerator.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MDZ3XMN82"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8MDZ3XMN82');
    </script>

    <!-- Google Fonts: Sora + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-brand-bg min-h-screen">
    <slot />
  </body>
</html>
