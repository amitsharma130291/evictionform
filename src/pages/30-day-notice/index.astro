          <tr><td class="border border-brand-border px-3 py-2">California (&lt;1 yr)</td><td class="border border-brand-border px-3 py-2">30 days</td><td class="border border-brand-border px-3 py-2">CCP § 1946.1</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">California (1+ yr)</td><td class="border border-brand-border px-3 py-2">60 days</td><td class="border border-brand-border px-3 py-2">CCP § 1946.1</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">New York (&lt;1 yr)</td><td class="border border-brand-border px-3 py-2">30 days</td><td class="border border-brand-border px-3 py-2">RPL § 226-c</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">New York (1–2 yr)</td><td class="border border-brand-border px-3 py-2">60 days</td><td class="border border-brand-border px-3 py-2">RPL § 226-c</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">New York (2+ yr)</td><td class="border border-brand-border px-3 py-2">90 days</td><td class="border border-brand-border px-3 py-2">RPL § 226-c</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">Oregon (1+ yr)</td><td class="border border-brand-border px-3 py-2">90 days + relocation assistance</td><td class="border border-brand-border px-3 py-2">ORS § 90.427</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">Texas</td><td class="border border-brand-border px-3 py-2">30 days</td><td class="border border-brand-border px-3 py-2">Prop Code § 91.001</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">Florida</td><td class="border border-brand-border px-3 py-2">30 days (month-to-month)</td><td class="border border-brand-border px-3 py-2">FS § 83.57</td></tr>
          <tr><td class="border border-brand-border px-3 py-2">Washington</td><td class="border border-brand-border px-3 py-2">20 days (month-to-month)</td><td class="border border-brand-border px-3 py-2">RCW § 59.18.200</td></tr>
