---
import Base from '../layouts/Base.astro';
const title = 'Privacy Policy | EvictionNoticeGenerator.com';
const description = 'Privacy policy for EvictionNoticeGenerator.com';
---
<Base {title} {description}>
  <main class="bg-brand-bg py-section-y">
    <article class="max-w-content mx-auto px-6">
      <h1 class="font-heading text-h1 font-bold text-brand-heading mb-8">Privacy Policy</h1>
      <p class="font-body text-small text-brand-muted mb-8">Last updated: August 2026</p>

      <h2 class="font-heading text-h2 font-semibold text-brand-heading mt-10 mb-4">Information We Collect</h2>
      <p class="font-body text-body-base text-brand-body mb-4">We collect information you voluntarily provide when using our eviction notice generator, including landlord name, tenant name, property address, and notice details. This information is used solely to generate your document and is not stored on our servers.</p>

      <h2 class="font-heading text-h2 font-semibold text-brand-heading mt-10 mb-4">How We Use Your Information</h2>
      <ul class="font-body text-body-base text-brand-body mb-4 pl-6 space-y-2 list-disc">
        <li>To generate your eviction notice PDF</li>
        <li>To respond to contact form submissions</li>
        <li>We do not sell, rent, or share your personal information with third parties</li>
      </ul>

      <h2 class="font-heading text-h2 font-semibold text-brand-heading mt-10 mb-4">Cookies</h2>
      <p class="font-body text-body-base text-brand-body mb-4">We use essential cookies only for basic site functionality. We do not use tracking or advertising cookies.</p>

      <h2 class="font-heading text-h2 font-semibold text-brand-heading mt-10 mb-4">Data Retention</h2>
      <p class="font-body text-body-base text-brand-body mb-4">Form data entered into our generator is processed in your browser and on our server only to generate the PDF. It is not retained after delivery.</p>

      <h2 class="font-heading text-h2 font-semibold text-brand-heading mt-10 mb-4">Contact</h2>
      <p class="font-body text-body-base text-brand-body mb-4">For privacy questions, contact us at: <a href="mailto:amitsharma00261@gmail.com" class="text-brand-cta hover:underline">amitsharma00261@gmail.com</a></p>

      <h2 class="font-heading text-h2 font-semibold text-brand-heading mt-10 mb-4">Disclaimer</h2>
      <p class="font-body text-body-base text-brand-body mb-4">EvictionNoticeGenerator.com provides document templates for informational purposes only. We are not a law firm and do not provide legal advice. Consult a licensed attorney for advice specific to your situation.</p>
    </article>
  </main>
</Base>
